[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

vram_compression/import_etc=true
vram_compression/import_etc2=false
quality/driver/driver_name="GLES2"
quality/driver/fallback_to_gles2=true
quality/directional_shadow/size=1024
quality/shadow_atlas/size=512
quality/shadows/filter_mode=0
quality/shading/force_lambert_over_burley=true
quality/shading/force_blinn_over_ggx=true
quality/skinning/software_skinning_fallback=false
quality/reflections/atlas_size=128
quality/reflections/atlas_subdiv=2
quality/depth/hdr=false
environment/default_environment="res://default_env.tres"
quality/skinning/software_skinning_fallback.mobile=false
quality/shadows/atlas_size=512
quality/shadows/atlas_subdiv=2
quality/subsurface_scattering/quality=0
physics/common/physics_fps=60
